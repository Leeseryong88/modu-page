# Browser-safe Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Exact production origin, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only; never prefix these with NEXT_PUBLIC_
FIREBASE_PROJECT_ID=
# Optional explicit credentials. Google-managed runtimes can use default credentials instead.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=
# Server-only random secret (32+ characters) for inquiry abuse limits. Never expose to the browser.
INQUIRY_RATE_LIMIT_SECRET=
# Local development only; never enable on Vercel
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
