{
  "name": "woori-upche",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit.test.ts tests/inquiries-unit.test.ts",
    "test:integration": "vitest run tests/integration.test.ts tests/inquiries-integration.test.ts",
    "emulators": "firebase emulators:start --project demo-woori --only auth,firestore,storage",
    "test:rules": "vitest run tests/rules.test.ts",
    "test:http": "node scripts/run-live-tests.mjs",
    "test:firebase": "firebase emulators:exec --project demo-woori --only auth,firestore,storage \"npm run test:integration && npm run test:rules\"",
    "dev:local": "node scripts/local-dev.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "firebase-tools": "^14.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
